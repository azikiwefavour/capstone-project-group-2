# Application
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Database (Neon PostgreSQL with TypeORM)
DATABASE_URL=postgresql://username:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_SSL=true

# Mail (Nodemailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="MedTrail <no-reply@medtrail.com>"

# OTP
OTP_EXPIRY_MINUTES=10

# Cache (in-memory by default; add REDIS_URL to switch to Redis in production)
CACHE_TTL=300
CACHE_MAX=500
# REDIS_URL=redis://localhost:6379

# PostHog Analytics & Feature Flags (Optional)
# POSTHOG_API_KEY=phc_your_posthog_api_key
# POSTHOG_HOST=https://us.i.posthog.com

# Rate Limiting / DDoS Protection (Optional overrides)
# THROTTLE_SHORT_LIMIT=15   # Max reqs per 1 second
# THROTTLE_MEDIUM_LIMIT=50  # Max reqs per 10 seconds
# THROTTLE_LONG_LIMIT=120   # Max reqs per 1 minute

# Termii SMS Gateway (Nigeria SMS for Offline/Elderly Patients & Caregivers)
# Sign up at https://termii.com to get your live API key
TERMII_API_KEY=your_termii_api_key
TERMII_SENDER_ID=MedTrail
TERMII_BASE_URL=https://api.ng.termii.com
TERMII_CHANNEL=generic

# Paystack Payment Gateway (Hospital Subscriptions & SMS Credit Top-Ups)
# Get your API keys at https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_your_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_your_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

