# Application
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=change_this_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/medtrail

# Mail (Nodemailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_app_password
MAIL_FROM="MedTrail <no-reply@medtrail.com>"

# OTP
OTP_EXPIRY_MINUTES=10
